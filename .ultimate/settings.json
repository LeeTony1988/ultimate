{
  "extensions": {
    "enable": ["voice-live"]
  },
  "instance": {
    "model": "openai-codex/gpt-6.1-sol"
  },
  "isolates": {
    "worktree": {
      "setup": ["pnpm install --frozen-lockfile --prefer-offline"]
    }
  },
  "lander": {
    "checks": [
      { "command": "pnpm check", "timeout": 120 },
      [
        { "command": "pnpm test", "timeout": 600 },
        { "command": "pnpm test:e2e", "timeout": 600 }
      ]
    ],
    "push": "origin"
  }
}
